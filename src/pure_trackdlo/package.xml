<?xml version="1.0"?>
<package format="3">
  <name>pure_trackdlo</name>
  <version>1.0.0</version>
  <description>
    Standalone C++ library implementing the TrackDLO algorithm.
    No ROS dependency — plain CMake.
  </description>
  <maintainer email="hanzitong1218@gmail.com">Nachi</maintainer>
  <license>MIT</license>

  <!-- colcon に cmake パッケージとして認識させるためのメタデータ -->
  <!-- build_type を cmake にすることで、colcon は ament_cmake ではなく -->
  <!-- 通常の cmake --build / cmake --install でビルドする -->
  <buildtool_depend>cmake</buildtool_depend>

  <build_depend>libeigen3-dev</build_depend>
  <exec_depend>libeigen3-dev</exec_depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
