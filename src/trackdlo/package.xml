<?xml version="1.0"?>
<package format="3">
  <name>trackdlo</name>
  <version>1.0.0</version>
  <description>
    ROS2 node for TrackDLO: deformable linear object tracking.
    Thin wrapper around pure_trackdlo and preprocessing libraries.
  </description>
  <maintainer email="hanzitong1218@gmail.com">Nachi</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 同じワークスペース内の非ROS2ライブラリ (cmake build type) -->
  <depend>pure_trackdlo</depend>
  <depend>preprocessing</depend>

  <!-- ROS2 依存 -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>message_filters</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
