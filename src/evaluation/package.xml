<?xml version="1.0"?>
<package format="3">
  <name>evaluation</name>
  <version>1.0.0</version>
  <description>
    Standalone C++ library for benchmarking TrackDLO tracking accuracy.
    No ROS dependency — plain CMake.
  </description>
  <maintainer email="hanzitong1218@gmail.com">Nachi</maintainer>
  <license>MIT</license>

  <buildtool_depend>cmake</buildtool_depend>

  <depend>pure_trackdlo</depend>

  <build_depend>libeigen3-dev</build_depend>
  <build_depend>libopencv-dev</build_depend>
  <build_depend>libpcl-dev</build_depend>
  <exec_depend>libeigen3-dev</exec_depend>
  <exec_depend>libopencv-dev</exec_depend>
  <exec_depend>libpcl-dev</exec_depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
